# Local development defaults only. Copy to .env; never reuse these values in a shared deployment.
APP_IMAGE_TAG=local
APP_ENV=development

# PostgreSQL / Redis bind only to localhost in the Compose file.
POSTGRES_DB=task_platform
POSTGRES_USER=task
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://task:local-dev-only@postgres:5432/task_platform
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# API and control plane.
API_BIND_ADDRESS=127.0.0.1
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CONTROL_PLANE_ENABLED=true
LEGACY_ANONYMOUS_ENABLED=true
BOOTSTRAP_ENABLED=true
# Leave empty only for a localhost development stack. Production bootstrap requires a strong token.
BOOTSTRAP_TOKEN=
LEGACY_PROJECT_ID=00000000-0000-0000-0000-000000000001
# Deliberately public local-only placeholders. Replace before any shared deployment.
API_KEY_PEPPER=local-development-api-key-pepper-change-me
WORKER_AUTH_TOKEN=local-development-worker-token
# Format: key-id:base64-encoded-32-byte-key[,old-key-id:base64-key]. Never commit a real key.
SECRET_MASTER_KEY=

# Must be unique for deployments sharing one Docker Engine.
CLUSTER_ID=mini-ai-cloud-local

# Worker identity and inventory. Leave WORKER_ID blank to generate one per replica.
WORKER_ID=
WORKER_NODE_NAME=
WORKER_CONCURRENCY=4
WORKER_LABELS=runtime=docker,region=local
WORKER_RUNTIME_TYPES=docker
# Comma-separated: nvidia-smi, ascend-npu-smi, kubernetes-node, fake, or none.
# fake and none are exclusive; FAKE_GPU_COUNT>0 preserves the v0.4 fake override.
ACCELERATOR_INVENTORY_PROVIDERS=nvidia-smi
HEARTBEAT_INTERVAL=5
WORKER_OFFLINE_TIMEOUT=15
WORKER_SHUTDOWN_TIMEOUT=30
WORKER_STOP_GRACE_PERIOD=40s

# Fake GPU is permitted only in development/test. APP_ENV=production rejects any non-zero count.
FAKE_GPU_COUNT=0
FAKE_GPU_MODEL=FAKE-A100
FAKE_GPU_MEMORY_MB=40960

# Task execution, fencing, recovery, and Docker hardening.
DEFAULT_TASK_TIMEOUT=60
MAX_TASK_TIMEOUT=86400
MAX_TASK_RETRIES=10
MAX_RECOVERY_ATTEMPTS=3
RECOVERY_CLEANUP_GRACE_SECONDS=5
RETRY_MAX_BACKOFF_SECONDS=60
TASK_LEASE_SECONDS=30
LEASE_RENEW_INTERVAL=5
DOCKER_STOP_TIMEOUT=5
DOCKER_ALWAYS_PULL=false
DOCKER_PIDS_LIMIT=256
DOCKER_TMPFS_SIZE_MB=64
MAX_TASK_LOG_BYTES=10485760
MAX_LOG_CHUNK_BYTES=65536
LOG_DRAIN_TIMEOUT=5
ORPHAN_RECONCILE_INTERVAL=1

# Scheduler v2. Global mode exercises PostgreSQL-fenced placement; preemption remains opt-in.
SCHEDULER_MODE=global
SCHEDULING_POLICY=binpack
SCHEDULER_POLL_INTERVAL=1
SCHEDULER_AGING_INTERVAL_SECONDS=60
SCHEDULER_PREEMPTION_ENABLED=false
SCHEDULER_PREEMPTION_MIN_DELTA=10

# Background control loops and Redis streams.
OUTBOX_POLL_INTERVAL=0.25
REAPER_INTERVAL=5
CONTROL_OPERATION_TIMEOUT=30
CONTROL_SHUTDOWN_TIMEOUT=10
HEALTH_CHECK_TIMEOUT=3
BATCH_SIZE=100
LOG_STREAM_MAXLEN=10000
LOG_STREAM_TTL_SECONDS=86400
READY_STREAM_MAXLEN=100000
REDIS_SOCKET_TIMEOUT=5
SSE_HEARTBEAT_SECONDS=10

# API abuse limits. Redis rate-limit failure is fail-closed by default.
API_REQUEST_MAX_BYTES=1048576
WEBSOCKET_QUEUE_SIZE=1000
API_KEY_RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_FAIL_OPEN=false

# Simulated pricing only; these values are not billing rates.
CPU_PRICE_PER_HOUR=0.05
GPU_PRICE_PER_HOUR=1.0
MEMORY_PRICE_PER_GB_HOUR=0.005

# Artifact storage. Default Compose uses a local volume.
ARTIFACT_BACKEND=local
ARTIFACT_LOCAL_ROOT=/var/lib/mini-ai-cloud/artifacts
# Worker-private staging; Compose shares only each declared file via a named-volume subpath.
ARTIFACT_WORKSPACE_ROOT=/var/lib/mini-ai-cloud/workspaces
DOCKER_ARTIFACT_WORKSPACE_VOLUME=
ARTIFACT_MAX_BYTES=10737418240
ARTIFACT_SIGNED_URL_TTL_SECONDS=900
ARTIFACT_S3_BUCKET=mini-ai-cloud
ARTIFACT_S3_ENDPOINT_URL=http://minio:9000
# Local MinIO profile placeholders; replace before any shared use.
MINIO_ROOT_USER=minio-local
MINIO_ROOT_PASSWORD=minio-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_DEFAULT_REGION=us-east-1

# Kubernetes runtime. A kubeconfig path also needs an explicit read-only mount into the Worker.
KUBERNETES_NAMESPACE=mini-ai-cloud
KUBERNETES_KUBECONFIG=
KUBERNETES_IN_CLUSTER=false
KUBERNETES_CLEANUP_GRACE_SECONDS=30
RUNTIME_PROFILE_MANIFEST_PATH=runtime_profiles/manifest.json

# Kubernetes-native model serving. Disabled by default; Fake Pods require a second
# explicit development/test-only opt-in. Use an image allowed by the project policy.
KUBERNETES_SERVING_ENABLED=false
KUBERNETES_SERVING_FAKE_ENABLED=false
KUBERNETES_SERVING_NAMESPACE=mini-ai-cloud-serving
KUBERNETES_SERVING_CLUSTER_ID=mini-ai-cloud-local
KUBERNETES_SERVING_IMAGE=
KUBERNETES_SERVING_STARTUP_TIMEOUT=120
KUBERNETES_SERVING_DRAIN_TIMEOUT=30
KUBERNETES_SERVING_POLL_INTERVAL=1
KUBERNETES_SERVING_PROBE_TIMEOUT=3
KUBERNETES_SERVING_LEASE_SECONDS=180
KUBERNETES_SERVING_FAILURE_BACKOFF=5
KUBERNETES_SERVING_TERMINATION_GRACE_SECONDS=30
KUBERNETES_SERVING_FAKE_STARTUP_DELAY=0
KUBERNETES_SERVING_FAKE_CHUNK_DELAY=0.02

# Model service controllers and gateway SSRF boundary.
SERVICE_RECONCILE_INTERVAL=2
SERVICE_HEALTH_INTERVAL=5
SERVICE_DRAIN_TIMEOUT=30
# TCP connection establishment timeout for model replica upstreams.
SERVICE_PROXY_CONNECT_TIMEOUT=5
# Time from gateway handling to the first non-empty upstream response chunk.
SERVICE_PROXY_FIRST_TOKEN_TIMEOUT=30
# Absolute inference request deadline. It also caps the two phase-specific timeouts above.
SERVICE_PROXY_TIMEOUT=120
# Maximum decoded bytes buffered for non-streaming model responses. SSE remains streamed.
SERVICE_PROXY_MAX_RESPONSE_BYTES=16777216
# Loopback is only for the in-process local fake inference server. Use a narrow worker host allowlist elsewhere.
SERVICE_ENDPOINT_HOST_ALLOWLIST=127.0.0.1
SERVICE_AUTOSCALE_INTERVAL=15
SERVICE_SCALE_TO_ZERO_ENABLED=false
# Optional default for vLLM services; production image policy may require an immutable digest.
VLLM_IMAGE=
# Disabled by default: enabling this controller requires a dedicated serving node and Docker socket.
SERVICE_VLLM_DOCKER_ENABLED=false
SERVICE_VLLM_WORKER_ID=
SERVICE_VLLM_ENDPOINT_HOST=127.0.0.1
SERVICE_VLLM_PUBLISH_ADDRESS=127.0.0.1
SERVICE_VLLM_CACHE_VOLUME=mini-ai-cloud-vllm-cache
SERVICE_VLLM_READY_TIMEOUT=600
SERVICE_VLLM_PROBE_TIMEOUT=3
SERVICE_VLLM_LEASE_SECONDS=900

# Retention controller. Referenced artifacts are protected from deletion.
CLEANUP_INTERVAL_SECONDS=3600
TASK_RETENTION_DAYS=30
LOG_RETENTION_DAYS=14
AUDIT_RETENTION_DAYS=365
ARTIFACT_RETENTION_DAYS=30

# Optional local observability profile.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d
GRAFANA_PORT=3000
